{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VMDragonSlayer Configuration",
  "description": "Schema for vmdragonslayer.yml configuration file.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
          "default": "INFO",
          "description": "Python logging level."
        },
        "file": {
          "type": "string",
          "default": "logs/vmds.log",
          "description": "Path to the log file."
        },
        "format": {
          "type": "string",
          "default": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
          "description": "Python logging format string."
        },
        "console": {
          "type": "boolean",
          "default": false,
          "description": "Also emit logs to the console."
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "default": 1800,
          "description": "Maximum analysis duration in seconds."
        },
        "max_threads": {
          "type": "integer",
          "minimum": 1,
          "default": 4,
          "description": "Maximum number of concurrent analysis threads."
        },
        "enable_caching": {
          "type": "boolean",
          "default": false,
          "description": "Cache intermediate analysis results for faster re-runs."
        }
      }
    },
    "tracing": {
      "type": "object",
      "description": "Trace collection backend configuration.",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["auto", "unicorn", "triton", "angr", "qiling", "file"],
          "default": "auto",
          "description": "Trace collection backend. 'auto' probes in order: unicorn, triton, angr, qiling."
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "default": 300,
          "description": "Wall-clock timeout per trace in seconds."
        },
        "max_instructions": {
          "type": "integer",
          "minimum": 1,
          "default": 100000,
          "description": "Maximum instructions to trace before stopping."
        },
        "capture_registers": {
          "type": "boolean",
          "default": true,
          "description": "Record register snapshots at each instruction."
        },
        "capture_memory": {
          "type": "boolean",
          "default": true,
          "description": "Record memory reads/writes."
        },
        "trace_output_dir": {
          "type": "string",
          "default": "traces/",
          "description": "Directory for trace output files."
        },
        "unicorn": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "follow_calls": {
              "type": "boolean",
              "default": true,
              "description": "Follow CALL instructions into subroutines."
            }
          }
        },
        "triton": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "symbolic": {
              "type": "boolean",
              "default": true,
              "description": "Enable Triton symbolic execution mode."
            },
            "taint": {
              "type": "boolean",
              "default": true,
              "description": "Enable Triton taint analysis mode."
            }
          }
        },
        "angr": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "auto_load_libs": {
              "type": "boolean",
              "default": false,
              "description": "Auto-load libraries in angr analysis."
            }
          }
        },
        "qiling": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "rootfs": {
              "type": "string",
              "default": "",
              "description": "Qiling rootfs path (e.g. 'rootfs/x86_linux')."
            },
            "multithread": {
              "type": "boolean",
              "default": false,
              "description": "Enable multi-threaded Qiling emulation."
            }
          }
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "API server bind address."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8000,
          "description": "API server port."
        },
        "workers": {
          "type": "integer",
          "minimum": 1,
          "default": 4,
          "description": "Number of Uvicorn workers."
        },
        "enable_cors": {
          "type": "boolean",
          "default": false,
          "description": "Enable CORS middleware on the API server."
        },
        "debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug mode (verbose error responses)."
        }
      }
    },
    "vmprotect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_depth": {
          "type": "integer",
          "minimum": 1,
          "default": 100000,
          "description": "Maximum trace instructions to record."
        },
        "enable_symbolic": {
          "type": "boolean",
          "default": true,
          "description": "Enable z3-based symbolic execution."
        },
        "llvm_opt_level": {
          "type": "string",
          "enum": ["O0", "O1", "O2", "O3"],
          "default": "O3",
          "description": "LLVM optimization level for IR lifting."
        },
        "skip_optimization": {
          "type": "boolean",
          "default": false,
          "description": "Skip LLVM optimization passes."
        },
        "validation_threshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.85,
          "description": "Minimum confidence for handler validation."
        },
        "confidence_threshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.8,
          "description": "Minimum confidence to accept a classification result."
        },
        "max_handler_size": {
          "type": "integer",
          "minimum": 1,
          "default": 10000,
          "description": "Maximum basic-block instruction count per handler."
        }
      }
    },
    "symbolic_execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "solver_timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "default": 10000,
          "description": "z3 solver timeout in milliseconds."
        },
        "max_paths": {
          "type": "integer",
          "minimum": 1,
          "default": 64,
          "description": "Maximum number of symbolic paths to explore."
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "default": 1000,
          "description": "Maximum symbolic exploration depth."
        },
        "max_loop_iters": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "Maximum loop unrolling iterations."
        },
        "memory_limit_mb": {
          "type": "integer",
          "minimum": 64,
          "default": 2048,
          "description": "Memory limit for symbolic engine in MB."
        }
      }
    },
    "data": {
      "type": "object",
      "description": "Data and model paths.",
      "additionalProperties": false,
      "properties": {
        "patterns_db": {
          "type": "string",
          "default": "data/patterns/vmprotect_handlers.json",
          "description": "Path to the patterns directory or database file."
        },
        "models_dir": {
          "type": "string",
          "default": "data/models/",
          "description": "Path to pre-trained model artefacts."
        },
        "samples_dir": {
          "type": "string",
          "default": "data/samples/",
          "description": "Path to binary samples."
        },
        "schemas_dir": {
          "type": "string",
          "default": "data/schemas/",
          "description": "Path to JSON schemas."
        }
      }
    },
    "paths": {
      "type": "object",
      "description": "Additional path overrides.",
      "additionalProperties": false,
      "properties": {
        "workspace_root": {
          "type": "string",
          "default": ".",
          "description": "Project workspace root."
        },
        "logs_dir": {
          "type": "string",
          "default": "logs/",
          "description": "Log file output directory."
        },
        "temp_dir": {
          "type": "string",
          "default": "temp/",
          "description": "Temporary working directory."
        },
        "output_dir": {
          "type": "string",
          "default": "output/",
          "description": "Analysis output directory."
        }
      }
    },
    "metroplex": {
      "type": "object",
      "description": "Metroplex integration settings.",
      "additionalProperties": true
    },
    "dispatcher": {
      "type": "object",
      "description": "Dispatcher analysis settings.",
      "additionalProperties": false,
      "properties": {
        "max_trace_length": {
          "type": "integer",
          "minimum": 1,
          "default": 500000,
          "description": "Traces longer than this are sub-sampled."
        },
        "early_exit_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.9,
          "description": "Skip remaining finders above this confidence."
        }
      }
    }
  }
}
